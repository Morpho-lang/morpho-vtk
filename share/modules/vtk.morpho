/* ***************************************************************
 * VTK
 * ===
 * Read and write Meshes and Fields in the legacy VTK format.
 **************************************************************** */

/* ----------------------------------------------------------------
 * The vtk module provides:
 * - VTKExporter : write a Mesh and Fields to a .vtk file
 * - VTKImporter : read a Mesh and Fields from a .vtk file
 *
 * Legacy unstructured-grid ASCII only. A field holds scalars or
 * 2D/3D column vectors on vertices, on cells, or on both.
 * ---------------------------------------------------------------- */

import meshtools
import parser

// VTK cell type ids: edge, triangle, tetrahedron
var _vtkCellType = Matrix([3, 5, 10])

// Error messages. Tags match the previous vtk module.
var _VtkInvalidFnameErr = Error("InvalidFname", "fieldname cannot have embedded whitespaces.")
var _VtkDuplicateFnameErr = Error("DuplicateFname", "A field with this name is already being exported.")
var _VtkFieldShapeErr = Error("FieldShapeErr", "The field shape cannot be written.")
var _VtkFieldDimErr = Error("FieldDimErr", "Expected a scalar or a 2D/3D vector field.")
var _VtkFieldMeshErr = Error("FieldMeshErr", "Field must be defined on the exporter mesh.")
var _VtkFieldNotFoundErr = Error("FieldNotFound", "Couldn't find the field in the file.")
var _VtkCellTypeErr = Error("CellTypeErr", "Unsupported or missing VTK cell type.")

// Check that a field name doesn't contain spaces.
fn _checkFieldName(Nil fieldname) { }
fn _checkFieldName(String fieldname) {
  for (c in fieldname) {
    if (c==" ") _VtkInvalidFnameErr.throw("fieldname (`${fieldname}`) cannot have embedded whitespaces.")
  }
}

// Append ".vtk" unless the name already ends in that extension.
fn _ensureVtk(String filename) {
  var fl = filename.split(".")
  var n = fl.count()
  if (n == 0) return "${filename}.vtk"
  if (fl[n-1] != "vtk") return "${filename}.vtk" // wrong extension, or a dot inside the name
  return filename
}

/* ----------------------------------------------------------------
 * VTKExporter
 *
 * Write a Mesh, and any Fields added to it, as one .vtk file.
 *   VTKExporter(mesh)
 *   VTKExporter(field, fieldname=nil)   also records that field
 *   addField(field, fieldname=nil)      addfield is the lowercase veneer
 *   export(filename)                    ".vtk" is appended if needed
 *
 * A missing fieldname becomes "scalars" or "vectors" when the file is written.
 * Two fields cannot share a name.
 * ---------------------------------------------------------------- */

class VTKExporter {
  _init(mesh) {
    self.fields = []
    self.fieldnames = []
    self.mesh = mesh
    self.maxg = mesh.maxgrade()
  }

  init(Mesh mesh, fieldname=nil) { self._init(mesh) }
  init(Field field, fieldname=nil) {
    self._init(field.mesh())
    self.addField(field, fieldname=fieldname)
  }

  _writePreamble(file) { // Legacy unstructured-grid header
    file.write("# vtk DataFile Version 3.0 ")
    file.write("Exported using Morpho https://github.com/Morpho-lang/morpho ")
    file.write("ASCII ")
    file.write("DATASET UNSTRUCTURED_GRID \n")
  }

  _writeEntry(file, Float v) { file.write("${v} ") }
  _writeEntry(file, Matrix v) { // Write x y z, padding a short vector with zeros
    var y = 0, z = 0
    if (v.count() > 1) y = v[1]
    if (v.count() > 2) z = v[2]
    file.write("${v[0]} ${y} ${z} ")
  }

  _writeArray(file, name, Float sample) {
    file.write("SCALARS ${name} float 1 ")
    file.write("LOOKUP_TABLE default ")
  }
  _writeArray(file, name, Matrix sample) {
    file.write("VECTORS ${name} float")
  }

  _writeVertices(file) {
    self.nvertices = self.mesh.count(0)
    file.write("POINTS ${self.nvertices} float ")
    for (id in 0...self.mesh.count()) {
      self._writeEntry(file, self.mesh.vertexposition(id))
    }
    file.write("\n")
  }

  // CELLS n size: n = sum n_g, size = sum (g+2)*n_g over grades 1..max.
  // Each cell is (g+1) vertex ids plus the leading count, hence g+2.
  _cellsKwargs(file) {
    self.n = 0
    self.size = 0
    for (g in 1..self.maxg) {
      var ng = self.mesh.count(g)
      self.n = self.n + ng
      self.size = self.size + (g + 2) * ng
    }
    file.write("CELLS ${self.n} ${self.size} ")
  }

  _writeCell(file, g, conn, id) {
    var vids = conn.rowindices(id)
    var cellstr = "${g+1} "
    for (v in 0..g) cellstr += "${vids[v]} "
    file.write("${cellstr}")
  }

  _writeCells(file) {
    self._cellsKwargs(file)
    for (g in 1..self.maxg) {
      var conn = self.mesh.connectivitymatrix(0, g)
      for (id in 0...self.mesh.count(g)) {
        self._writeCell(file, g, conn, id)
      }
    }
    file.write("\n")
  }

  _writeCellTypes(file) { // CELL_TYPES uses the n computed for CELLS
    file.write("CELL_TYPES ${self.n}")
    for (g in 1..self.maxg) {
      for (id in 0...self.mesh.count(g)) {
        file.write("${_vtkCellType[g-1]} ")
      }
    }
    file.write("\n")
  }

  _writeMesh(file) {
    self._writeVertices(file)
    self._writeCells(file)
    self._writeCellTypes(file)
  }

  _sample(field) { // One stored value
    var shp = field.shape()
    for (g in 0...shp.count()) {
      if (shp[g] != 0 and field.mesh().count(g) > 0) return field[g, 0]
    }
    return nil
  }

  _checkValue(v) { // Scalar, or a 2D or 3D column vector
    if (isfloat(v)) return
    var dim = v.dimensions()
    if (dim[1] != 1) {
      _VtkFieldDimErr.throw("Expected a scalar or a 2D/3D vector field, but received a non-columnar matrix with dimensions ${dim}.")
    }
    if (dim[0] != 2 and dim[0] != 3) {
      _VtkFieldDimErr.throw("Expected a scalar or a 2D/3D vector field, but received a vector field with ${dim[0]} dimensions.")
    }
  }

  _checkField(field) {
    var shp = field.shape()
    var mesh = field.mesh()
    var any = false
    var cell = false
    for (g in 0...shp.count()) {
      if (shp[g] != 0 and shp[g] != 1) {
        _VtkFieldShapeErr.throw("Received a field with shape `${shp}`. Each grade must hold one value or none.")
      }
      if (shp[g] == 0 or mesh.count(g) == 0) continue
      if (g > 0) cell = true
      any = true
    }
    if (!any) {
      _VtkFieldShapeErr.throw("Received a field with shape `${shp}`. The field has no values to write.")
    }
    self._checkValue(self._sample(field))
    if (cell) {
      for (g in 1..mesh.maxgrade()) {
        if (mesh.count(g) == 0) continue
        var n = 0
        if (g < shp.count()) n = shp[g]
        if (n == 0) {
          _VtkFieldShapeErr.throw("Received a field with shape `${shp}`. The field must provide a value for every cell.")
        }
      }
    }
  }

  _hasGrade(field, g) {
    var shp = field.shape()
    if (g >= shp.count()) return false
    return shp[g] != 0 and field.mesh().count(g) > 0
  }

  _hasCellData(field) {
    var shp = field.shape()
    for (g in 1...shp.count()) {
      if (self._hasGrade(field, g)) return true
    }
    return false
  }

  _arrayName(name, sample) {
    if (!isnil(name)) return name
    if (isfloat(sample)) return "scalars"
    return "vectors"
  }

  _writeValues(file, field, fieldname) { // Header for this field's scalar or vector values
    var sample = self._sample(field)
    self._writeArray(file, self._arrayName(fieldname, sample), sample)
  }

  _writePointField(file, field, fieldname) {
    self._writeValues(file, field, fieldname)
    for (id in 0...self.mesh.count()) self._writeEntry(file, field[0, id])
    file.write("\n")
  }

  _writeCellField(file, field, fieldname) {
    self._writeValues(file, field, fieldname)
    for (g in 1..self.maxg) {
      if (!self._hasGrade(field, g)) continue
      for (id in 0...self.mesh.count(g)) self._writeEntry(file, field[g, id])
    }
    file.write("\n")
  }

  addField(Field field, fieldname=nil) {
    self._checkField(field)
    if (field.mesh() != self.mesh) {
      _VtkFieldMeshErr.throw("Field is defined on a different mesh than the one being exported.")
    }
    _checkFieldName(fieldname)
    var name = self._arrayName(fieldname, self._sample(field))
    for (n in self.fieldnames) {
      if (n == name) _VtkDuplicateFnameErr.throw("The name `${name}` is already used by another field.")
    }
    self.fields.append(field)
    self.fieldnames.append(name)
  }

  addfield(field, fieldname=nil) { self.addField(field, fieldname=fieldname) } // [Compatibility shim]

  export(String filename) {
    self.filename = _ensureVtk(filename)
    var f = File(self.filename, "write")
    self._writePreamble(f)
    self._writeMesh(f)
    var nf = self.fields.count()
    var point = false
    var cell = false
    for (i in 0...nf) {
      if (self._hasGrade(self.fields[i], 0)) point = true
      if (self._hasCellData(self.fields[i])) cell = true
    }
    if (point) {
      f.write("POINT_DATA ${self.nvertices} ")
      for (i in 0...nf) {
        if (self._hasGrade(self.fields[i], 0)) self._writePointField(f, self.fields[i], self.fieldnames[i])
      }
    }
    if (cell) {
      f.write("CELL_DATA ${self.n} ")
      for (i in 0...nf) {
        if (self._hasCellData(self.fields[i])) self._writeCellField(f, self.fields[i], self.fieldnames[i])
      }
    }
    f.close()
  }
}

/* ----------------------------------------------------------------
 * VTKImporter
 *
 * Read a legacy unstructured-grid .vtk file.
 *   VTKImporter(filename)          ".vtk" is appended if needed
 *   mesh() -> Mesh
 *   field(fieldname) -> Field
 *   fieldList() -> List            fieldlist is the lowercase veneer
 *   containsField(fieldname) -> Bool
 *                                 containsfield is the lowercase veneer
 * ---------------------------------------------------------------- */

class VTKImporter {
  init(String filename) {
    self.filename = _ensureVtk(filename)
    self.mb = MeshBuilder(dimension=3)
    self.mesh = nil
    self.fields = Dictionary()
    self.cellIds = []
    self.cellGrades = []
    self.cellsTyped = false
    self.names = []
    self.pointValues = Dictionary()
    self.cellValues = Dictionary()
    self.onCells = false
    self.f = File(self.filename)
    self.tok = Tokenizer(self.f)

    while (!self.f.eof()) {
      self.t = self.tok.next()

      if (self.t=="POINTS") {
        self.nvertices = Int(self.tok.next())
        self.t = self.tok.next() // skip "float"
        for (i in 0...self.nvertices) self._addVertex()
      }

      if (self.t=="CELLS") {
        self.ncells = Int(self.tok.next())
        self.t = self.tok.next() // skip the size count
        for (i in 0...self.ncells) self.cellIds.append(self._readCell())
      }

      if (self.t=="CELL_TYPES") self._readCellTypes()

      if (self.t=="POINT_DATA") {
        self._ensureCellTypes()
        self._buildMesh()
        self.onCells = false
      }

      if (self.t=="CELL_DATA") {
        self._ensureCellTypes()
        self._buildMesh()
        self.onCells = true
      }

      if (self.t=="SCALARS") {
        self.fieldname = self.tok.next()
        for (j in 1..4) self.t = self.tok.next() // float, 1, LOOKUP_TABLE, default
        self._store(self._readScalars(self._valueCount()))
      }

      if (self.t=="VECTORS") {
        self.fieldname = self.tok.next()
        self.t = self.tok.next() // skip "float"
        self._store(self._readVectors(self._valueCount()))
      }
    }

    // A mesh-only file never reaches POINT_DATA.
    self._ensureCellTypes()
    self._buildMesh()
    self._buildFields()
    self.f.close()
  }

  _buildMesh() {
    if (isnil(self.mesh)) self.mesh = self.mb.build()
  }

  _valueCount() {
    if (self.onCells) return self.cellGrades.count()
    return self.nvertices
  }

  _readScalars(n) {
    var vals = []
    for (i in 0...n) vals.append(Float(self.tok.next()))
    return vals
  }

  _readVectors(n) {
    var vals = []
    for (i in 0...n) vals.append(self._getVector())
    return vals
  }

  _store(vals) { // Save one named array of values
    var name = self.fieldname
    var known = self.pointValues.contains(name) or self.cellValues.contains(name)
    if (!known) self.names.append(name)
    if (self.onCells) self.cellValues[name] = vals
    else self.pointValues[name] = vals
  }

  _buildFields() {
    for (name in self.names) {
      var points = nil
      var cells = nil
      if (self.pointValues.contains(name)) points = self.pointValues[name]
      if (self.cellValues.contains(name)) cells = self.cellValues[name]
      self.fields[name] = self._makeField(points, cells)
    }
  }

  _gradeSpec(vertices) { // Which grades hold a value
    var grade = []
    for (g in 0..self.mesh.maxgrade()) grade.append(0)
    if (vertices) grade[0] = 1
    for (g in 1..self.mesh.maxgrade()) {
      if (self.mesh.count(g) > 0) grade[g] = 1
    }
    return grade
  }

  _assignPoints(field, List points) {
    for (id in 0...points.count()) field[0, id] = points[id]
  }

  _assignCells(field, List cells) {
    var seen = []
    for (g in 0..self.mesh.maxgrade()) seen.append(0)
    for (i in 0...cells.count()) {
      var g = self.cellGrades[i]
      var id = seen[g]
      field[g, id] = cells[i]
      seen[g] = id + 1
    }
  }

  _prototype(List vals) { // Sample value for the new field
    if (vals.count() == 0) return 0.0
    return vals[0]
  }

  _makeField(List points, Nil cells) { // Vertex values
    var field = Field(self.mesh, self._prototype(points))
    self._assignPoints(field, points)
    return field
  }

  _makeField(Nil points, List cells) { // Cell values
    var field = Field(self.mesh, self._prototype(cells), grade=self._gradeSpec(false))
    self._assignCells(field, cells)
    return field
  }

  _makeField(List points, List cells) { // Vertex and cell values
    var field = Field(self.mesh, self._prototype(points), grade=self._gradeSpec(true))
    self._assignPoints(field, points)
    self._assignCells(field, cells)
    return field
  }

  _readCell() { // Read one cell's vertex ids
    var n = Int(self.tok.next())
    var ids = []
    for (i in 0...n) ids.append(Int(self.tok.next()))
    return ids
  }

  _readCellTypes() {
    var ntypes = Int(self.tok.next())
    if (ntypes != self.cellIds.count()) {
      _VtkCellTypeErr.throw("CELL_TYPES has ${ntypes} entries but CELLS has ${self.cellIds.count()}.")
    }
    for (i in 0...ntypes) self._applyCellType(self.cellIds[i], Int(self.tok.next()))
    self.cellsTyped = true
  }

  _ensureCellTypes() {
    if (self.cellIds.count() > 0 and !self.cellsTyped) {
      _VtkCellTypeErr.throw("The file has CELLS but no CELL_TYPES section.")
    }
  }

  _applyCellType(ids, ctype) { // Add a line, triangle, or tetrahedron
    var n = ids.count()
    if (ctype == 3) {
      if (n != 2) _VtkCellTypeErr.throw("A line must have 2 points, but received ${n}.")
      self.mb.addedge(ids)
      self.cellGrades.append(1)
    } else if (ctype == 5) {
      if (n != 3) _VtkCellTypeErr.throw("A triangle must have 3 points, but received ${n}.")
      self.mb.addface(ids)
      self.cellGrades.append(2)
    } else if (ctype == 10) {
      if (n != 4) _VtkCellTypeErr.throw("A tetrahedron must have 4 points, but received ${n}.")
      self.mb.addvolume(ids)
      self.cellGrades.append(3)
    } else {
      _VtkCellTypeErr.throw("Unsupported cell. Only lines, triangles, and tetrahedra are supported.")
    }
  }

  _getVector() {
    var vx = Float(self.tok.next())
    var vy = Float(self.tok.next())
    var vz = Float(self.tok.next())
    return Matrix([vx, vy, vz])
  }

  _addVertex() {
    self.mb.addvertex(self._getVector())
  }

  mesh() { return self.mesh }

  field(String fieldname) {
    _checkFieldName(fieldname)
    try {
      return self.fields[fieldname]
    } catch {
      "DctKyNtFnd":
        _VtkFieldNotFoundErr.throw("Couldn't find the field `${fieldname}` in the file.")
    }
  }

  fieldList() { return self.fields.keys() }

  fieldlist() { return self.fieldList() } // [Compatibility shim]

  containsField(String fieldname) {
    _checkFieldName(fieldname)
    return self.fields.contains(fieldname)
  }

  containsfield(fieldname) { return self.containsField(fieldname) } // [Compatibility shim]
}
